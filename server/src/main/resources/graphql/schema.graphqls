"""
Lettuce read-only integration API v1 (v3.0.0). THE hand-maintained contract for
POST /integration/graphql (the documentation.yaml sibling — see api-guidelines/GRAPHQL-GUIDELINES.md;
IntegrationSchemaContractTest pins the runtime schema to this file). Authenticated by an
integration-client API key; every read is unscoped by design (no per-caller authorization) —
scope changes are additive; a non-additive change (rename/removal/nullability tightening) follows
the GQL-CON-005 protocol (a MINOR release's @deprecated(reason: "... Removed in <MAJOR>.0.0.")
window, then the removal only in that MAJOR release).
Schema version: v1 — breaking changes land only in app 4.0.0 (GQL-CON-005).
Conventions: ids are unsigned 31-bit Int; dates are ISO strings (YYYY-MM-DD, months YYYY-MM);
timestamps are epoch milliseconds (Long). There is deliberately no Mutation type.
Dangling references: records retain the ids/names of soft-deleted users and teams (data is
never destroyed), so an embedded id may not resolve via user(id)/team(id) and may be absent
from the users/teams roots — mirrors that enforce referential integrity must treat embedded
ids as historical labels, not foreign keys.
"""
schema {
  query: Query
}

"64-bit signed integer (epoch-millisecond timestamps exceed 32-bit Int)."
scalar Long

"The read-only root: paged bulk-sync collections per family plus id-addressed single reads."
type Query {
  "Page through all non-deleted users. Filters AND together; name/email are case- and accent-insensitive substring matches."
  users(
    "1-based page number (>= 1)." page: Int = 1
    "Rows per page (1..100)." pageSize: Int = 20
    "Substring filter on the display name." name: String
    "Substring filter on the email." email: String
    "true = only deactivated accounts, false = only active ones; omit for both." deactivated: Boolean
  ): UserPage!

  "A single non-deleted user, or null when the id is unknown or soft-deleted."
  user("The user id." id: Int!): User

  "Page through all non-deleted teams."
  teams(
    "1-based page number (>= 1)." page: Int = 1
    "Rows per page (1..100)." pageSize: Int = 20
    "Case- and accent-insensitive substring filter on the team name." name: String
  ): TeamPage!

  "A single non-deleted team, or null when the id is unknown or soft-deleted."
  team("The team id." id: Int!): Team

  "The global, admin-curated review-period registry (small, unpaged, chronological)."
  reviewPeriods: [ReviewPeriod!]!

  "The global, admin-curated paid days-off pool kinds (v3.2.0 — active kinds only, default first then name)."
  daysOffPoolTypes: [DaysOffPoolType!]!

  "Page through all days-off requests (bulk sync). from/to bound startDate (ISO YYYY-MM-DD, inclusive)."
  daysOff(
    "1-based page number (>= 1)." page: Int = 1
    "Rows per page (1..100)." pageSize: Int = 20
    "Lower startDate bound, ISO YYYY-MM-DD inclusive." from: String
    "Upper startDate bound, ISO YYYY-MM-DD inclusive." to: String
    "Only entries owned by this user." userId: Int
  ): DaysOffPage!

  "Page through all performance reviews (bulk sync), every status including DRAFT."
  performanceReviews(
    "1-based page number (>= 1)." page: Int = 1
    "Rows per page (1..100)." pageSize: Int = 20
    "Only reviews attached to this review period." periodId: Int
    "Only reviews about this subordinate." subordinateId: Int
  ): PerformanceReviewPage!

  "Page through all team KPIs (bulk sync), every status including DRAFT."
  teamKpis(
    "1-based page number (>= 1)." page: Int = 1
    "Rows per page (1..100)." pageSize: Int = 20
    "Only KPIs of this team." teamId: Int
    "Only KPIs in this status." status: TeamKpiStatus
  ): TeamKpiPage!
}

# ---- Paging envelopes (the REST list convention: items/page/pageSize/total; total is the
# ---- row count after filters, before pagination).

"One page of users."
type UserPage {
  "The page's rows, id-ascending." items: [User!]!
  "The 1-based page number echoed back." page: Int!
  "The page size echoed back." pageSize: Int!
  "Row count after filters, before pagination." total: Long!
}

"One page of teams."
type TeamPage {
  "The page's rows, id-ascending." items: [Team!]!
  "The 1-based page number echoed back." page: Int!
  "The page size echoed back." pageSize: Int!
  "Row count after filters, before pagination." total: Long!
}

"One page of days-off requests."
type DaysOffPage {
  "The page's rows, id-ascending." items: [DaysOff!]!
  "The 1-based page number echoed back." page: Int!
  "The page size echoed back." pageSize: Int!
  "Row count after filters, before pagination." total: Long!
}

"One page of performance reviews."
type PerformanceReviewPage {
  "The page's rows, id-ascending." items: [PerformanceReview!]!
  "The 1-based page number echoed back." page: Int!
  "The page size echoed back." pageSize: Int!
  "Row count after filters, before pagination." total: Long!
}

"One page of team KPIs."
type TeamKpiPage {
  "The page's rows, id-ascending." items: [TeamKpi!]!
  "The 1-based page number echoed back." page: Int!
  "The page size echoed back." pageSize: Int!
  "Row count after filters, before pagination." total: Long!
}

# ---- Enums (mirror the server's Kotlin enums by name).

"Additional global roles; a user with neither is a regular user."
enum UserRole {
  "Management role: user/team/template/alert administration." ADMIN
  "Read-only auditor role with org-wide read access." HR
}

"Whether a days-off request consumes the paid budget."
enum DaysOffType {
  "Deducted from the yearly paid budget." PAID
  "Not budget-relevant." UNPAID
}

"Whether a budget correction adds or subtracts days."
enum DaysOffCorrectionOperation {
  "Grants extra days." ADD
  "Removes days." SUBTRACT
}

"The performance-review lifecycle."
enum PerformanceReviewStatus {
  "Private to its author in the product; readable here." DRAFT
  "Under cross-manager calibration." CALIBRATION
  "Final and visible to the subordinate." PUBLISHED
}

"How a team KPI's value is expressed."
enum TeamKpiType {
  "A plain numeric series." NUMBER
  "A 0-100 percentage series." PERCENTAGE
}

"The team-KPI lifecycle."
enum TeamKpiStatus {
  "Being defined; private to managers in the product." DRAFT
  "Live and collecting data points." ACTIVE
  "Closed with a summary (may be reopened)." ARCHIVED
}

"Which side of the KPI target is good."
enum TargetDirection {
  "Values at or above the target are good." AT_LEAST
  "Values at or below the target are good." AT_MOST
}

# ---- Object types.

"A career-dictionary entry (career path / specialization / seniority level), resolved at read time."
type DictionaryEntry {
  "The dictionary entry id." id: Int!
  "The entry's translations, one per language." values: [DictionaryValue!]!
}

"One language's display text of a dictionary entry."
type DictionaryValue {
  "ISO language code (e.g. en, pl)." language: String!
  "The display text in that language." value: String!
}

"A user account with the career profile and per-user sub-collections."
type User {
  "The user id." id: Int!
  "Display name." name: String!
  "Login email (canonical lower-case)." email: String!
  "Optional organization-assigned unique id (employee id); null when not set." uniqueId: String
  "Additional global roles; empty for a regular user." roles: [UserRole!]!
  "true = the account is administratively deactivated (cannot log in; data remains)." deactivated: Boolean!
  "The user's UI/email language code." language: String!
  "Current career path, from the latest career position; null when none." careerPath: DictionaryEntry
  "Current specialization, from the latest career position; null when none." careerSpecialization: DictionaryEntry
  "Current seniority level, from the latest career position; null when none." seniorityLevel: DictionaryEntry
  "The full chronological career-position timeline (start ascending)." careerHistory: [CareerPosition!]!
  "Teams this user is currently a member of (name ascending)." teams: [TeamRef!]!
  "The user's team-membership history: every dated membership period in any team, past, current and upcoming, in start order (a null start first), then team name, then id. Includes periods in since-deleted teams (flagged by team.deleted); rows of teams deleted before dated records began (open-ended residue) are omitted." teamMemberships: [UserTeamPeriod!]!
  "The user's manager history: every dated period in which they managed a team, in start order (a null start first), then team name, then id. Same deleted-team rules as teamMemberships." managedTeamPeriods: [UserTeamPeriod!]!
  "The user's days-off requests, id ascending, optionally limited to startDates of one calendar year (2000..2100)." daysOff("Calendar year filter (e.g. 2026)." year: Int): [DaysOff!]!
  "The user's DEFAULT paid pool budget for a year (closed-form; null never occurs — an unconfigured allowance yields a zero budget). Since v3.2.0 one of possibly several pools — see daysOffBudgets." daysOffBudget("The budget year (2000..2100)." year: Int!): DaysOffBudget!
  "The user's budgets in EVERY paid pool for a year (v3.2.0): the default pool first, then every other pool by name — active grants and archived pools that still hold history in that year alike (see poolArchived)." daysOffBudgets("The budget year (2000..2100)." year: Int!): [DaysOffBudget!]!
  "Manager corrections of the user's paid budget, newest year (then newest row) first, optionally limited to one year (2000..2100)." daysOffCorrections("The correction year (2000..2100)." year: Int): [DaysOffCorrection!]!
  "Performance reviews where this user is the subordinate (every status), id ascending." performanceReviews: [PerformanceReview!]!
}

"A lightweight team reference."
type TeamRef {
  "The team id." id: Int!
  "The team name." name: String!
}

"A lightweight user reference."
type UserRef {
  "The user id." id: Int!
  "The display name." name: String!
}

"A team with its manager, roster, and KPIs."
type Team {
  "The team id." id: Int!
  "The team name." name: String!
  "The team's current manager (may be a since-deleted user — see the schema note)." manager: UserRef!
  "Current members with display names." members: [UserRef!]!
  "The team's KPIs (every status)." kpis: [TeamKpi!]!
  "Every dated membership period of the team's roster (past, current and upcoming), ordered by startDate (a null start first), then id. The same person may appear several times (a rejoin is a new period); a person's membership never overlaps itself within the team." memberships: [TeamMembershipPeriod!]!
  "The team's manager succession line, oldest first: contiguous periods, the last one open-ended while the team is live." managerPeriods: [TeamManagerPeriod!]!
}

"One membership period of a person in a team. Dates are ISO YYYY-MM-DD; a null startDate means the membership began before records were kept, a null endDate means it is open-ended, otherwise endDate is the INCLUSIVE last day."
type TeamMembershipPeriod {
  "The membership period id." id: Int!
  "The member (may be a since-deleted user — see userDeleted)." user: UserRef!
  "true = the member's account has been deleted (the name is kept as a historical label)." userDeleted: Boolean!
  "true = the member's account is administratively deactivated." deactivated: Boolean!
  "ISO YYYY-MM-DD first day of the membership; null = since before records." startDate: String
  "ISO YYYY-MM-DD inclusive last day of the membership; null = open-ended." endDate: String
  "true = the period covers today (the server's date)." current: Boolean!
}

"One period of a team's manager succession line. Dates follow TeamMembershipPeriod: each period ends the day before the next one starts and the last one is open-ended."
type TeamManagerPeriod {
  "The manager period id." id: Int!
  "The manager during this period (may be a since-deleted user — see managerDeleted)." manager: UserRef!
  "true = the manager's account has been deleted (the name is kept as a historical label)." managerDeleted: Boolean!
  "ISO YYYY-MM-DD first day of the period; null = since before records." startDate: String
  "ISO YYYY-MM-DD inclusive last day of the period; null = open-ended." endDate: String
  "true = the period covers today (the server's date)." current: Boolean!
}

"One period of a person's team history: a membership period (User.teamMemberships) or a managed-team period (User.managedTeamPeriods). Dates follow TeamMembershipPeriod."
type UserTeamPeriod {
  "The period id (a membership id or a manager-period id, depending on the field)." id: Int!
  "The team the period belongs to." team: TeamHistoryRef!
  "ISO YYYY-MM-DD first day of the period; null = since before records." startDate: String
  "ISO YYYY-MM-DD inclusive last day of the period; null = open-ended." endDate: String
  "true = the period covers today and the team is not deleted." current: Boolean!
}

"A team named by a history row; carries the deletion flag because history outlives the team."
type TeamHistoryRef {
  "The team id." id: Int!
  "The team name." name: String!
  "true = the team has been deleted (its periods ended on the deletion day)." deleted: Boolean!
}

"One row of a user's career timeline."
type CareerPosition {
  "The position row id." id: Int!
  "ISO YYYY-MM-DD start." startDate: String!
  "Derived end (day before the next row starts, or the stored deactivation end); null = the open-ended current position." endDate: String
  "Career path at this position; null when not set." careerPath: DictionaryEntry
  "Specialization at this position; null when not set." careerSpecialization: DictionaryEntry
  "Seniority level at this position; null when not set." seniorityLevel: DictionaryEntry
  "Row creation timestamp." createdAt: Long!
  "Last modification timestamp." lastModified: Long!
}

"A days-off entry with its frozen cost (v3.9.0 — no approval lifecycle; an entry exists until soft-deleted)."
type DaysOff {
  "The entry id." id: Int!
  "The owner's user id (may reference a since-deleted user — see the schema note)." userId: Int!
  "The owner's display name (retained even if the user was deleted)." userName: String!
  "PAID or UNPAID." type: DaysOffType!
  "The paid pool kind's id (v3.2.0); null for UNPAID." poolTypeId: Int
  "The paid pool kind's current name (v3.2.0); null for UNPAID." poolName: String
  "ISO YYYY-MM-DD first day." startDate: String!
  "ISO YYYY-MM-DD last day (same calendar year as startDate)." endDate: String!
  "true = the first day is a half day." startHalf: Boolean!
  "true = the last day is a half day." endHalf: Boolean!
  "Frozen working-day cost in days (0.5 steps; weekends/holidays cost nothing)." days: Float!
  "Entry creation timestamp." createdAt: Long!
  "Last modification timestamp." lastModified: Long!
}

"A user's budget in ONE paid days-off pool for one year (closed-form: remaining = carriedOver + allowance + corrected - used; carriedOver is 0 for a non-carry-over kind)."
type DaysOffBudget {
  "The owner's user id (may reference a since-deleted user — see the schema note)." userId: Int!
  "The owner's display name (retained even if the user was deleted)." userName: String!
  "The budget year." year: Int!
  "The pool kind's id (v3.2.0)." poolTypeId: Int!
  "The pool kind's current name (v3.2.0)." poolName: String!
  "Whether unused days of this pool carry over year to year (v3.2.0)." carriesOver: Boolean!
  "Whether this is the seeded default pool kind (v3.2.0)." isDefault: Boolean!
  "A non-default pool with history in this year but no active grant (or a grant whose kind was archived) — renders as history, takes no new requests (v3.2.1)." poolArchived: Boolean!
  "The chain-manager-set yearly allowance in days; null = no active grant of this pool (zero budget)." allowance: Int
  "Days carried over from the previous year." carriedOver: Float!
  "The year's net manager corrections in days (signed)." corrected: Float!
  "Active PAID days in the year (v3.9.0 — every entry counts, no reserved/used split)." used: Float!
  "Remaining paid days (may be negative)." remaining: Float!
}

"A manager's correction of a user's paid-days-off entitlement."
type DaysOffCorrection {
  "The correction id." id: Int!
  "The corrected user's id." userId: Int!
  "The authoring manager's user id." authorId: Int!
  "The authoring manager's display name." authorName: String!
  "The adjusted pool kind's id (v3.2.0)." poolTypeId: Int!
  "The adjusted pool kind's current name (v3.2.0)." poolName: String!
  "The budget year the correction applies to." year: Int!
  "ADD or SUBTRACT." operation: DaysOffCorrectionOperation!
  "The correction size in days (0.5 steps)." days: Float!
  "The mandatory reasoning (stored encrypted at rest)." comment: String!
  "Correction creation timestamp." createdAt: Long!
  "Last modification timestamp." lastModified: Long!
}

"One admin-curated kind of paid days-off pool (v3.2.0)."
type DaysOffPoolType {
  "The pool kind id." id: Int!
  "The pool kind's name." name: String!
  "Whether unused days carry over year to year (false = the pool resets every January)." carriesOver: Boolean!
  "Whether this is the seeded default kind every pre-v3.2.0 paid request maps to." isDefault: Boolean!
}

"One admin-curated review period (inclusive ISO month bounds)."
type ReviewPeriod {
  "The period id." id: Int!
  "ISO YYYY-MM first month." startMonth: String!
  "ISO YYYY-MM last month." endMonth: String!
}

"One rated category of a performance review (both fields stored encrypted at rest)."
type CategoryAssessment {
  "The 1..6 rating; null while unset." rating: Int
  "The category summary text; null while unset." summary: String
}

"A performance review (five rated categories; content decrypted for integration clients)."
type PerformanceReview {
  "The review id." id: Int!
  "The authoring manager's user id (may reference a since-deleted user — see the schema note)." managerId: Int!
  "The authoring manager's display name (retained even if the user was deleted)." managerName: String!
  "The subordinate's user id (may reference a since-deleted user — see the schema note)." subordinateId: Int!
  "The subordinate's display name." subordinateName: String!
  "The attached review period's id." periodId: Int!
  "The period's ISO YYYY-MM first month." periodStartMonth: String!
  "The period's ISO YYYY-MM last month." periodEndMonth: String!
  "Current lifecycle status (DRAFTs are visible to integration clients)." status: PerformanceReviewStatus!
  "The attitude category." attitude: CategoryAssessment!
  "The delivery category." delivery: CategoryAssessment!
  "The skills category." skills: CategoryAssessment!
  "The aptitude category." aptitude: CategoryAssessment!
  "The overall category." overall: CategoryAssessment!
  "Review creation timestamp." createdAt: Long!
  "Last modification timestamp." lastModified: Long!
}

"A team KPI with its recorded data-point series."
type TeamKpi {
  "The KPI id." id: Int!
  "The owning team's id (may reference a since-deleted team — see the schema note)." teamId: Int!
  "The owning team's name (retained even if the team was deleted)." teamName: String!
  "The team's current manager's user id (resolved at read time, never stored)." managerId: Int!
  "The team's current manager's display name." managerName: String!
  "The KPI title." title: String!
  "The KPI description (stored encrypted at rest)." description: String!
  "NUMBER or PERCENTAGE." type: TeamKpiType!
  "Current lifecycle status (DRAFTs are visible to integration clients)." status: TeamKpiStatus!
  "The target value." targetValue: Float!
  "Which side of the target is good." targetDirection: TargetDirection!
  "The latest recorded value (0 when none recorded)." currentValue: Float!
  "ISO YYYY-MM-DD date of the latest recorded value; null when none." currentValueDate: String
  "The archive summary (stored encrypted at rest); non-null once archived at least once." summary: String
  "KPI creation timestamp." createdAt: Long!
  "Last modification timestamp." lastModified: Long!
  "Recorded data points, date descending." values: [TeamKpiValue!]!
}

"One recorded team-KPI data point."
type TeamKpiValue {
  "The data-point id." id: Int!
  "ISO YYYY-MM-DD measurement date." date: String!
  "The measured value." value: Float!
}
